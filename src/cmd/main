#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

start_process() {
    if status; then
        log_msg "应用已在运行"
        return 0
    fi
    log_msg "启动应用..."

    cd "${TRIM_APPDEST}/server" || {
        echo "无法进入目录" > "$TRIM_TEMP_LOGFILE"
        return 1
    }

    export wizard_port="${wizard_port:-5664}"
    export TRIM_SERVICE_PORT="${wizard_port}"
    export wizard_storage_volume="${wizard_storage_volume:-vol1}"
    export wizard_upload_path="${wizard_upload_path:-}"
    export wizard_admin_user="${wizard_admin_user:-admin}"
    export wizard_admin_pass="${wizard_admin_pass:-admin123}"
    export TRIM_APPDEST="${TRIM_APPDEST}"
    export TRIM_PKGVAR="${TRIM_PKGVAR}"
    export TRIM_PKGETC="${TRIM_PKGETC}"
    export TRIM_DATA_SHARE_PATH="/${wizard_storage_volume}/@appshare/cloud-collection"
    export TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}"
    export TRIM_TEMP_LOGFILE="${TRIM_TEMP_LOGFILE}"

    log_msg "========================================"
    log_msg "存储卷: ${wizard_storage_volume}"
    log_msg "数据目录: ${TRIM_DATA_SHARE_PATH}"
    log_msg "服务端口: ${TRIM_SERVICE_PORT}"
    log_msg "========================================"

    PYTHONPATH="${TRIM_APPDEST}/server/vendor:${PYTHONPATH}" \
    python3 app.pyc >> "$LOG_FILE" 2>&1 &

    echo $! > "$PID_FILE"
    sleep 2

    if kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        log_msg "启动成功 PID=$(cat "$PID_FILE")"
        return 0
    else
        echo "启动失败" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi
}

stop_process() {
    log_msg "停止应用..."
    if [ -f "$PID_FILE" ]; then
        pid=$(head -n1 "$PID_FILE" | tr -d '[:space:]')
        if kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid"
            sleep 3
            kill -0 "$pid" 2>/dev/null && kill -KILL "$pid"
        fi
        rm -f "$PID_FILE"
    fi
    return 0
}

status() {
    if [ -f "$PID_FILE" ]; then
        pid=$(head -n1 "$PID_FILE" | tr -d '[:space:]')
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 3
}

case $1 in
    start) start_process; exit $? ;;
    stop) stop_process; exit $? ;;
    status) status; exit $? ;;
    *) exit 1 ;;
esac